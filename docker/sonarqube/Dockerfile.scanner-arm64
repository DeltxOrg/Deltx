# Native Linux AArch64 SonarScanner CLI for OCI Ampere A1.
# Source and checksum: https://github.com/SonarSource/sonarqube-scan-action/blob/master/sonar-scanner-version
FROM --platform=linux/arm64 debian:bookworm-slim AS download

ARG SCANNER_VERSION=8.1.0.6389
ARG SCANNER_SHA256=5e1c9328f4e261838de778c9e586ee608cca45ff7f0538108642219214628ba5

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL "https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-${SCANNER_VERSION}-linux-aarch64.zip" -o /tmp/scanner.zip \
    && echo "${SCANNER_SHA256}  /tmp/scanner.zip" | sha256sum -c - \
    && unzip -q /tmp/scanner.zip -d /opt \
    && set -- /opt/sonar-scanner-* \
    && test "$#" -eq 1 \
    && test -d "$1" \
    && mv "$1" /opt/sonar-scanner

FROM --platform=linux/arm64 debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libstdc++6 zlib1g \
    && rm -rf /var/lib/apt/lists/*
COPY --from=download /opt/sonar-scanner /opt/sonar-scanner
WORKDIR /usr/src
ENTRYPOINT ["/opt/sonar-scanner/bin/sonar-scanner"]
